# Copy these names into your shell or a local secret manager. The loader reads
# process environment variables directly; it does not parse this file.
PGHOST=localhost
PGPORT=5432
PGDATABASE=customer_support_analytics
PGUSER=your_postgres_role
# PGPASSWORD is optional for trusted/local authentication. Never commit a value.
PGPASSWORD=
PGSSLMODE=prefer

# Analytics API settings. Keep secrets in the PG* variables above.
API_TITLE=Customer Support Analytics API
API_VERSION=1.0.0
API_DB_CONNECT_TIMEOUT=5
