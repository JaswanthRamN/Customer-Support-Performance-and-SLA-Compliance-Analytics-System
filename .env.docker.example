# Copy to .env.docker, replace every change-me value, and pass it with
# docker compose --env-file .env.docker. This file contains no real secrets.
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432
FASTAPI_PORT=8000
DJANGO_PORT=8001
AIRFLOW_PORT=8080
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-password
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
DJANGO_SECRET_KEY=change-me-long-random-django-secret
